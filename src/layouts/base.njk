<!doctype html>
<html
  lang="en"
  data-ga="{{ site.gaId }}"
  style="--color-primary: {{ page.accent.primary }}; --color-primary-hover: {{ page.accent.hover }}; --color-on-primary: {{ page.accent.onPrimary }}; --title-gradient: {{ page.accent.gradient }}"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ page.title }}</title>
    <meta name="description" content="{{ page.description }}" />
    <link rel="canonical" href="{{ page.canonical }}" />
    <meta name="robots" content="{{ page.robots }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="{{ page.ogTitle }}" />
    <meta property="og:description" content="{{ page.ogDescription }}" />
    <meta property="og:url" content="{{ page.canonical }}" />
    <meta property="og:image" content="{{ site.domain }}{{ page.ogImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ page.ogTitle }}" />
    <meta name="twitter:card" content="{{ site.twitterCard }}" />
    <meta name="twitter:title" content="{{ page.ogTitle }}" />
    <meta name="twitter:description" content="{{ page.ogDescription }}" />
    <meta name="twitter:image" content="{{ site.domain }}{{ page.ogImage }}" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <link rel="mask-icon" href="/assets/img/mask-icon.svg" color="#3b82f6" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/assets/css/app.css" />
    {% if page.jsonld %} {% for block in page.jsonld %}
    <script type="application/ld+json">
      {{ block | safe }}
    </script>
    {% endfor %} {% endif %}
  </head>
  <body
    data-page="{{ page.pageName }}"
    class="flex min-h-screen flex-col bg-gradient-to-br from-slate-900 to-slate-800 text-slate-50"
  >
    <a class="skip-link" href="#main-content">Skip to content</a>
    {% include "partials/header.njk" %} {% if page.breadcrumbs %} {% include
    "partials/breadcrumbs.njk" %} {% endif %}
    <main id="main-content" tabindex="-1" class="{{ page.mainClass }}">
      <noscript class="col-span-full">
        <p class="noscript">
          These tools run entirely in your browser, which means they need
          JavaScript. Enable it and reload — nothing is ever sent to a server.
        </p>
      </noscript>
      {% if page.hero %}
      <div class="col-span-full pt-4 pb-2 text-center">
        <h1
          class="title-gradient text-2xl font-bold pb-2 md:text-4xl"
        >
          {{ page.h1 }}
        </h1>
        {% if page.subtitle %}
        <p class="text-slate-400">{{ page.subtitle }}</p>
        {% endif %}
      </div>
      {% endif %} {{ page.body | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <script src="/assets/js/app.js" defer></script>
    {% for v in page.vendor %}
    <script src="/assets/vendor/{{ v }}.js" defer></script>
    {% endfor %} {% if page.script %}
    <script src="/assets/js/{{ page.script }}" defer></script>
    {% endif %}
  </body>
</html>
