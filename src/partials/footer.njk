<footer class="mt-auto w-full border-t border-white/10">
  <div
    class="mx-auto grid w-full max-w-7xl gap-8 px-4 py-10 sm:grid-cols-2 md:px-8 lg:grid-cols-4"
  >
    <div class="max-w-sm">
      <div class="mb-2 font-semibold text-slate-200">Unitoolify</div>
      <p class="text-sm leading-relaxed text-slate-400">
        Developer tools that run in your browser. Encode, format, convert and
        generate — your input never leaves your device.
      </p>
    </div>
    <nav aria-label="Popular tools">
      <div class="mb-2 font-semibold text-slate-200">Popular Tools</div>
      <ul class="grid grid-cols-1 gap-y-1.5 text-sm">
        {% for item in popular %}
        <li>
          <a
            class="text-slate-400 no-underline hover:text-slate-200"
            href="{{ item.url }}"
            >{{ item.label }}</a
          >
        </li>
        {% endfor %}
      </ul>
    </nav>
    <nav aria-label="Tool categories">
      <div class="mb-2 font-semibold text-slate-200">Categories</div>
      <ul class="grid grid-cols-1 gap-y-1.5 text-sm">
        {% for item in categories %}
        <li>
          <a
            class="text-slate-400 no-underline hover:text-slate-200"
            href="/#{{ item.id }}"
            >{{ item.name }}</a
          >
        </li>
        {% endfor %}
      </ul>
    </nav>
    <nav aria-label="Popular searches">
      <div class="mb-2 font-semibold text-slate-200">Popular Searches</div>
      <ul class="grid grid-cols-1 gap-y-1.5 text-sm">
        {% for item in searches %}
        <li>
          <a
            class="text-slate-400 no-underline hover:text-slate-200"
            href="{{ item.url }}"
            >{{ item.label }}</a
          >
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10 py-6 text-center text-sm text-slate-400">
    &copy; {{ year }} Unitoolify ·
    <a class="text-slate-400 underline hover:text-slate-200" href="/privacy/"
      >Privacy</a
    >
    ·
    <button
      type="button"
      class="cursor-pointer underline hover:text-slate-200"
      data-consent-open
    >
      Cookie settings</button
    >·
    <a class="text-slate-400 underline hover:text-slate-200" href="/sitemap.xml"
      >Sitemap</a
    >
  </div>
</footer>
